{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModManifest",
  "type": "object",
  "required": ["id", "name", "version"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "description": "Unique mod package identifier."
    },
    "name": {
      "type": "string",
      "description": "Display name of the mod."
    },
    "version": {
      "type": "string",
      "description": "Semantic version (e.g. 1.0.0)."
    },
    "author": {
      "type": "string",
      "description": "Author or team name."
    },
    "description": {
      "type": "string",
      "description": "Short description of what the mod adds."
    },
    "priority": {
      "type": "integer",
      "default": 100,
      "description": "Ingestion priority; lower numbers load first (Core = 0)."
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of mod IDs that must be loaded prior to this mod."
    }
  },
  "additionalProperties": false
}
